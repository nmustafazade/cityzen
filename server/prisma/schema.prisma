generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CITIZEN
  EMPLOYEE
  DEPARTMENT_HEAD
  ADMIN
}

enum ReportStatus {
  SUBMITTED
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED
  CANCELLED
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  REPORT_CREATED
  REPORT_ASSIGNED
  REPORT_STATUS_CHANGED
  REPORT_COMMENT
  REPORT_RESOLVED
  SERVICE_REQUEST_CREATED
  SERVICE_REQUEST_ASSIGNED
  SERVICE_REQUEST_STATUS_CHANGED
  SERVICE_REQUEST_COMPLETED
  EMERGENCY_ALERT
  WASTE_COLLECTION_REMINDER
}

enum ServiceRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum RoadEventType {
  ACCIDENT
  ROAD_CLOSURE
  CONSTRUCTION
  MAINTENANCE
  LANE_CLOSURE
  FLOODING
  CONGESTION
  TEMPORARY_RESTRICTION
  HAZARD
  OTHER
}

enum RoadEventSeverity {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum RoadEventStatus {
  SCHEDULED
  ACTIVE
  RESOLVED
  CANCELLED
}

enum ParkingFacilityType {
  STREET
  GARAGE
  LOT
  UNDERGROUND
}

enum ParkingReservationStatus {
  RESERVED
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

enum InfrastructureDataSource {
  MUNICIPALITY
  OPENSTREETMAP
  OPEN_DATA
  HERE
  DEMO
  OPEN_METEO
  EMERGENCY_AUTHORITY
}

enum WasteType {
  GENERAL
  RECYCLING
  ORGANIC
  GLASS
  PAPER
  PLASTIC
  METAL
  ELECTRONIC
  HAZARDOUS
  BULKY
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum WasteScheduleExceptionType {
  CANCELLED
  RESCHEDULED
  EXTRA_COLLECTION
}

enum WasteFacilityType {
  PUBLIC_BIN
  RECYCLING_BIN
  RECYCLING_CENTER
  E_WASTE_POINT
  HAZARDOUS_WASTE_POINT
  COMPOST_POINT
}

enum EnvironmentalMetric {
  PM25
  PM10
  AQI
  TEMPERATURE
  HUMIDITY
  NO2
  O3
  CO
  SO2
  NOISE_DB
}

enum EmergencyAlertSeverity {
  ADVISORY
  WATCH
  WARNING
  CRITICAL
}

enum EmergencyAlertType {
  SEVERE_WEATHER
  FLOOD
  FIRE
  EARTHQUAKE
  INFRASTRUCTURE_FAILURE
  WATER_DISRUPTION
  POWER_DISRUPTION
  PUBLIC_SAFETY
  ROAD_EMERGENCY
  OTHER
}

model User {
  id                       Int                           @id @default(autoincrement())
  firstName                String
  lastName                 String
  email                    String                        @unique
  passwordHash             String
  role                     UserRole                      @default(CITIZEN)
  phone                    String?
  profileImageUrl          String?
  isActive                 Boolean                       @default(true)
  isEmailVerified          Boolean                       @default(false)
  departmentId             Int?
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  department               Department?                   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  addresses                Address[]
  submittedReports         Report[]                      @relation("CitizenReports")
  assignedReports          Report[]                      @relation("AssignedEmployeeReports")
  reportChanges            ReportStatusHistory[]         @relation("ReportStatusChangedBy")
  reportComments           ReportComment[]
  reportUpvotes            ReportUpvote[]
  reportFeedbacks          ReportFeedback[]              @relation("CitizenReportFeedback")
  notifications            Notification[]                @relation("NotificationRecipient")
  notificationActs         Notification[]                @relation("NotificationActor")
  announcements            Announcement[]                @relation("AnnouncementCreator")
  cityEvents               CityEvent[]                   @relation("CityEventCreator")
  serviceRequests          ServiceRequest[]              @relation("CitizenServiceRequests")
  assignedServiceRequests  ServiceRequest[]              @relation("AssignedServiceRequests")
  serviceRequestChanges    ServiceRequestStatusHistory[] @relation("ServiceRequestChangedBy")
  createdRoadEvents        RoadEvent[]                   @relation("RoadEventCreator")
  parkingReservations      ParkingReservation[]          @relation("CitizenParkingReservations")
  wasteReminderPreferences WasteReminderPreference[]
  wasteReminderDeliveries  WasteReminderDelivery[]
  createdEmergencyAlerts   EmergencyAlert[]              @relation("EmergencyAlertCreator")

  @@index([role])
  @@index([departmentId])
}

model Department {
  id                    Int                    @id @default(autoincrement())
  name                  String                 @unique
  description           String?
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  employees             User[]
  reports               Report[]
  categories            ReportCategory[]
  services              MunicipalService[]
  announcements         Announcement[]
  cityEvents            CityEvent[]
  serviceRequests       ServiceRequest[]
  roadEvents            RoadEvent[]
  parkingFacilities     ParkingFacility[]
  cityFacilities        CityFacility[]
  wasteZones            WasteCollectionZone[]
  wasteFacilities       WasteFacility[]
  environmentalStations EnvironmentalStation[]
  emergencyAlerts       EmergencyAlert[]
}

model Address {
  id                       Int                       @id @default(autoincrement())
  userId                   Int
  label                    String?
  country                  String
  city                     String
  district                 String?
  neighborhood             String?
  street                   String?
  buildingNumber           String?
  postalCode               String?
  latitude                 Decimal?                  @db.Decimal(10, 7)
  longitude                Decimal?                  @db.Decimal(10, 7)
  isPrimary                Boolean                   @default(false)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wasteCollectionZoneId    Int?
  wasteCollectionZone      WasteCollectionZone?      @relation(fields: [wasteCollectionZoneId], references: [id], onDelete: SetNull)
  wasteReminderPreferences WasteReminderPreference[]

  @@index([userId, isPrimary])
  @@index([wasteCollectionZoneId])
}

model SystemHealth {
  id        Int      @id @default(autoincrement())
  name      String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReportCategory {
  id           Int         @id @default(autoincrement())
  name         String      @unique
  description  String?
  icon         String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  reports      Report[]

  @@index([departmentId])
}

model Report {
  id                 Int                   @id @default(autoincrement())
  title              String
  description        String                @db.Text
  status             ReportStatus          @default(SUBMITTED)
  priority           ReportPriority        @default(MEDIUM)
  addressText        String?
  latitude           Decimal?              @db.Decimal(10, 7)
  longitude          Decimal?              @db.Decimal(10, 7)
  citizenId          Int
  categoryId         Int
  departmentId       Int?
  assignedEmployeeId Int?
  resolvedAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  citizen            User                  @relation("CitizenReports", fields: [citizenId], references: [id], onDelete: Restrict)
  category           ReportCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  department         Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignedEmployee   User?                 @relation("AssignedEmployeeReports", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  images             ReportImage[]
  statusHistory      ReportStatusHistory[]
  comments           ReportComment[]
  upvotes            ReportUpvote[]
  feedback           ReportFeedback?
  notifications      Notification[]

  @@index([citizenId, createdAt])
  @@index([categoryId])
  @@index([departmentId])
  @@index([assignedEmployeeId])
  @@index([status, createdAt])
  @@index([priority])
}

model ReportImage {
  id        Int      @id @default(autoincrement())
  reportId  Int
  imageUrl  String
  createdAt DateTime @default(now())
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model ReportStatusHistory {
  id          Int           @id @default(autoincrement())
  reportId    Int
  oldStatus   ReportStatus?
  newStatus   ReportStatus
  changedById Int
  note        String?
  createdAt   DateTime      @default(now())
  report      Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  changedBy   User          @relation("ReportStatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
  @@index([changedById])
}

model ReportComment {
  id              Int             @id @default(autoincrement())
  reportId        Int
  userId          Int
  parentCommentId Int?
  content         String          @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  report          Report          @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  parentComment   ReportComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies         ReportComment[] @relation("CommentReplies")

  @@index([reportId, createdAt])
  @@index([userId])
  @@index([parentCommentId])
  @@index([createdAt])
}

model ReportUpvote {
  id        Int      @id @default(autoincrement())
  reportId  Int
  userId    Int
  createdAt DateTime @default(now())
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([reportId, userId])
  @@index([userId])
  @@index([createdAt])
}

model ReportFeedback {
  id        Int      @id @default(autoincrement())
  reportId  Int      @unique
  citizenId Int
  rating    Int
  comment   String?  @db.Text
  confirmed Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  citizen   User     @relation("CitizenReportFeedback", fields: [citizenId], references: [id], onDelete: Restrict)

  @@index([citizenId])
}

model Notification {
  id               Int              @id @default(autoincrement())
  userId           Int
  type             NotificationType
  title            String
  message          String
  reportId         Int?
  serviceRequestId Int?
  emergencyAlertId Int?
  actorId          Int?
  isRead           Boolean          @default(false)
  readAt           DateTime?
  createdAt        DateTime         @default(now())
  user             User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Restrict)
  report           Report?          @relation(fields: [reportId], references: [id], onDelete: SetNull)
  serviceRequest   ServiceRequest?  @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  emergencyAlert   EmergencyAlert?  @relation(fields: [emergencyAlertId], references: [id], onDelete: SetNull)
  actor            User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@index([reportId])
  @@index([serviceRequestId])
  @@index([emergencyAlertId])
}

model MunicipalService {
  id              Int              @id @default(autoincrement())
  departmentId    Int
  title           String
  description     String           @db.Text
  instructions    String?          @db.Text
  requirements    String?          @db.Text
  contactPhone    String?
  contactEmail    String?
  externalUrl     String?
  address         String?
  imageUrl        String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  department      Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  serviceRequests ServiceRequest[]

  @@index([departmentId])
  @@index([isActive])
  @@index([title])
}

model ServiceRequest {
  id                   Int                           @id @default(autoincrement())
  serviceId            Int
  citizenId            Int
  departmentId         Int
  assignedEmployeeId   Int?
  status               ServiceRequestStatus          @default(SUBMITTED)
  description          String                        @db.Text
  address              String?
  latitude             Decimal?                      @db.Decimal(10, 7)
  longitude            Decimal?                      @db.Decimal(10, 7)
  preferredDate        DateTime?
  contactPhone         String?
  municipalityResponse String?                       @db.Text
  submittedAt          DateTime                      @default(now())
  completedAt          DateTime?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  service              MunicipalService              @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  citizen              User                          @relation("CitizenServiceRequests", fields: [citizenId], references: [id], onDelete: Restrict)
  department           Department                    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  assignedEmployee     User?                         @relation("AssignedServiceRequests", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  history              ServiceRequestStatusHistory[]
  notifications        Notification[]

  @@index([citizenId, createdAt])
  @@index([departmentId, status])
  @@index([assignedEmployeeId, status])
  @@index([serviceId])
}

model ServiceRequestStatusHistory {
  id               Int                   @id @default(autoincrement())
  serviceRequestId Int
  oldStatus        ServiceRequestStatus?
  newStatus        ServiceRequestStatus
  changedById      Int
  note             String?               @db.Text
  createdAt        DateTime              @default(now())
  serviceRequest   ServiceRequest        @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  changedBy        User                  @relation("ServiceRequestChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([serviceRequestId, createdAt])
  @@index([changedById])
}

model Announcement {
  id           Int         @id @default(autoincrement())
  departmentId Int?
  title        String
  content      String      @db.Text
  isPublished  Boolean     @default(false)
  publishedAt  DateTime?
  expiresAt    DateTime?
  imageUrl     String?
  createdById  Int
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdBy    User        @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([departmentId])
  @@index([isPublished, publishedAt])
  @@index([expiresAt])
}

model CityEvent {
  id           Int         @id @default(autoincrement())
  departmentId Int?
  title        String
  description  String      @db.Text
  locationName String?
  address      String?
  latitude     Decimal?    @db.Decimal(10, 7)
  longitude    Decimal?    @db.Decimal(10, 7)
  startsAt     DateTime
  endsAt       DateTime?
  externalUrl  String?
  imageUrl     String?
  isPublished  Boolean     @default(false)
  publishedAt  DateTime?
  createdById  Int
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdBy    User        @relation("CityEventCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([departmentId])
  @@index([isPublished, startsAt])
  @@index([startsAt])
}

model RoadEvent {
  id               Int                      @id @default(autoincrement())
  departmentId     Int
  createdById      Int
  title            String
  description      String                   @db.Text
  type             RoadEventType
  severity         RoadEventSeverity
  status           RoadEventStatus          @default(SCHEDULED)
  address          String?
  latitude         Decimal                  @db.Decimal(10, 7)
  longitude        Decimal                  @db.Decimal(10, 7)
  startsAt         DateTime
  endsAt           DateTime?
  isPublic         Boolean                  @default(true)
  resolvedAt       DateTime?
  source           InfrastructureDataSource @default(MUNICIPALITY)
  externalSourceId String?
  sourceUrl        String?
  lastSyncedAt     DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  department       Department               @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdBy        User                     @relation("RoadEventCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([source, externalSourceId])
  @@index([departmentId, status])
  @@index([isPublic, status, startsAt])
  @@index([type, severity])
  @@index([latitude, longitude])
  @@index([source, lastSyncedAt])
}

model ParkingFacility {
  id                  Int                      @id @default(autoincrement())
  departmentId        Int
  name                String
  description         String?                  @db.Text
  type                ParkingFacilityType
  address             String
  latitude            Decimal                  @db.Decimal(10, 7)
  longitude           Decimal                  @db.Decimal(10, 7)
  totalSpaces         Int
  availableSpaces     Int?
  accessibleSpaces    Int                      @default(0)
  evChargingSpaces    Int                      @default(0)
  hourlyPrice         Decimal?                 @db.Decimal(10, 2)
  currency            String?
  openingHours        String?
  supportsReservation Boolean                  @default(false)
  isActive            Boolean                  @default(true)
  source              InfrastructureDataSource @default(MUNICIPALITY)
  externalSourceId    String?
  sourceUrl           String?
  lastSyncedAt        DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  department          Department               @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  reservations        ParkingReservation[]

  @@unique([source, externalSourceId])
  @@index([departmentId, isActive])
  @@index([type, isActive])
  @@index([latitude, longitude])
  @@index([name])
  @@index([source, lastSyncedAt])
}

model ParkingReservation {
  id                Int                      @id @default(autoincrement())
  parkingFacilityId Int
  citizenId         Int
  startsAt          DateTime
  endsAt            DateTime
  status            ParkingReservationStatus @default(RESERVED)
  cancelledAt       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  parkingFacility   ParkingFacility          @relation(fields: [parkingFacilityId], references: [id], onDelete: Restrict)
  citizen           User                     @relation("CitizenParkingReservations", fields: [citizenId], references: [id], onDelete: Restrict)

  @@index([citizenId, createdAt])
  @@index([parkingFacilityId, startsAt, endsAt])
  @@index([status])
}

model CityFacilityCategory {
  id          Int            @id @default(autoincrement())
  name        String         @unique
  icon        String?
  description String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  facilities  CityFacility[]

  @@index([isActive, name])
}

model CityFacility {
  id               Int                      @id @default(autoincrement())
  categoryId       Int
  departmentId     Int?
  name             String
  description      String?                  @db.Text
  address          String
  latitude         Decimal                  @db.Decimal(10, 7)
  longitude        Decimal                  @db.Decimal(10, 7)
  phone            String?
  email            String?
  website          String?
  openingHours     String?
  isActive         Boolean                  @default(true)
  source           InfrastructureDataSource @default(MUNICIPALITY)
  externalSourceId String?
  sourceUrl        String?
  lastSyncedAt     DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  category         CityFacilityCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  department       Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([source, externalSourceId])
  @@index([categoryId, isActive])
  @@index([departmentId, isActive])
  @@index([latitude, longitude])
  @@index([name])
  @@index([source, lastSyncedAt])
}

model WasteCollectionZone {
  id           Int                       @id @default(autoincrement())
  departmentId Int
  name         String
  description  String?
  city         String?
  district     String?
  neighborhood String?
  postalCode   String?
  isActive     Boolean                   @default(true)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  department   Department                @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  addresses    Address[]
  schedules    WasteCollectionSchedule[]
  exceptions   WasteScheduleException[]

  @@unique([departmentId, name])
  @@index([isActive, city, district])
}

model WasteCollectionSchedule {
  id             Int                 @id @default(autoincrement())
  zoneId         Int
  wasteType      WasteType
  dayOfWeek      Weekday
  collectionTime String?
  notes          String?
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  zone           WasteCollectionZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, wasteType, dayOfWeek])
  @@index([zoneId, isActive])
}

model WasteScheduleException {
  id              Int                        @id @default(autoincrement())
  zoneId          Int
  wasteType       WasteType?
  date            DateTime                   @db.Date
  type            WasteScheduleExceptionType
  replacementDate DateTime?                  @db.Date
  note            String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  zone            WasteCollectionZone        @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId, date])
}

model WasteFacility {
  id               Int                         @id @default(autoincrement())
  departmentId     Int?
  type             WasteFacilityType
  name             String?
  description      String?                     @db.Text
  address          String?
  latitude         Decimal                     @db.Decimal(10, 7)
  longitude        Decimal                     @db.Decimal(10, 7)
  openingHours     String?
  isActive         Boolean                     @default(true)
  source           InfrastructureDataSource    @default(MUNICIPALITY)
  externalSourceId String?
  sourceUrl        String?
  lastSyncedAt     DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  department       Department?                 @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  acceptedTypes    WasteFacilityAcceptedType[]

  @@unique([source, externalSourceId])
  @@index([type, isActive])
  @@index([departmentId, isActive])
  @@index([latitude, longitude])
}

model WasteFacilityAcceptedType {
  facilityId Int
  wasteType  WasteType
  facility   WasteFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([facilityId, wasteType])
  @@index([wasteType])
}

model WasteReminderPreference {
  id                  Int       @id @default(autoincrement())
  userId              Int
  addressId           Int
  wasteType           WasteType
  enabled             Boolean   @default(true)
  reminderHoursBefore Int       @default(12)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  address             Address   @relation(fields: [addressId], references: [id], onDelete: Cascade)

  @@unique([userId, addressId, wasteType])
  @@index([enabled])
}

model WasteReminderDelivery {
  id             Int       @id @default(autoincrement())
  userId         Int
  addressId      Int
  wasteType      WasteType
  collectionDate DateTime  @db.Date
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, addressId, wasteType, collectionDate])
  @@index([collectionDate])
}

model EnvironmentalStation {
  id               Int                        @id @default(autoincrement())
  departmentId     Int?
  name             String
  description      String?
  latitude         Decimal                    @db.Decimal(10, 7)
  longitude        Decimal                    @db.Decimal(10, 7)
  address          String?
  source           InfrastructureDataSource   @default(MUNICIPALITY)
  externalSourceId String?
  sourceUrl        String?
  lastSyncedAt     DateTime?
  isActive         Boolean                    @default(true)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  department       Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  measurements     EnvironmentalMeasurement[]

  @@unique([source, externalSourceId])
  @@index([departmentId, isActive])
  @@index([latitude, longitude])
}

model EnvironmentalMeasurement {
  id         Int                      @id @default(autoincrement())
  stationId  Int
  metric     EnvironmentalMetric
  value      Decimal                  @db.Decimal(14, 4)
  unit       String
  measuredAt DateTime
  source     InfrastructureDataSource @default(MUNICIPALITY)
  createdAt  DateTime                 @default(now())
  station    EnvironmentalStation     @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId, measuredAt])
  @@index([metric, measuredAt])
}

model EmergencyAlert {
  id               Int                      @id @default(autoincrement())
  departmentId     Int?
  createdById      Int
  type             EmergencyAlertType
  severity         EmergencyAlertSeverity
  title            String
  message          String                   @db.Text
  latitude         Decimal?                 @db.Decimal(10, 7)
  longitude        Decimal?                 @db.Decimal(10, 7)
  radiusKm         Decimal?                 @db.Decimal(10, 2)
  startsAt         DateTime
  endsAt           DateTime?
  isPublished      Boolean                  @default(false)
  publishedAt      DateTime?
  source           InfrastructureDataSource @default(MUNICIPALITY)
  externalSourceId String?
  sourceUrl        String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  department       Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy        User                     @relation("EmergencyAlertCreator", fields: [createdById], references: [id], onDelete: Restrict)
  notifications    Notification[]

  @@unique([source, externalSourceId])
  @@index([isPublished, startsAt, endsAt])
  @@index([departmentId])
  @@index([severity])
}
