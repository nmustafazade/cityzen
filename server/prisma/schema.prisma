generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CITIZEN
  EMPLOYEE
  DEPARTMENT_HEAD
  ADMIN
}

enum ReportStatus {
  SUBMITTED
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED
  CANCELLED
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  REPORT_CREATED
  REPORT_ASSIGNED
  REPORT_STATUS_CHANGED
  REPORT_COMMENT
  REPORT_RESOLVED
  SERVICE_REQUEST_CREATED
  SERVICE_REQUEST_ASSIGNED
  SERVICE_REQUEST_STATUS_CHANGED
  SERVICE_REQUEST_COMPLETED
}

enum ServiceRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

model User {
  id                      Int                           @id @default(autoincrement())
  firstName               String
  lastName                String
  email                   String                        @unique
  passwordHash            String
  role                    UserRole                      @default(CITIZEN)
  phone                   String?
  profileImageUrl         String?
  isActive                Boolean                       @default(true)
  isEmailVerified         Boolean                       @default(false)
  departmentId            Int?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  department              Department?                   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  addresses               Address[]
  submittedReports        Report[]                      @relation("CitizenReports")
  assignedReports         Report[]                      @relation("AssignedEmployeeReports")
  reportChanges           ReportStatusHistory[]         @relation("ReportStatusChangedBy")
  reportComments          ReportComment[]
  reportUpvotes           ReportUpvote[]
  reportFeedbacks         ReportFeedback[]              @relation("CitizenReportFeedback")
  notifications           Notification[]                @relation("NotificationRecipient")
  notificationActs        Notification[]                @relation("NotificationActor")
  announcements           Announcement[]                @relation("AnnouncementCreator")
  cityEvents              CityEvent[]                   @relation("CityEventCreator")
  serviceRequests         ServiceRequest[]              @relation("CitizenServiceRequests")
  assignedServiceRequests ServiceRequest[]              @relation("AssignedServiceRequests")
  serviceRequestChanges   ServiceRequestStatusHistory[] @relation("ServiceRequestChangedBy")

  @@index([role])
  @@index([departmentId])
}

model Department {
  id              Int                @id @default(autoincrement())
  name            String             @unique
  description     String?
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  employees       User[]
  reports         Report[]
  categories      ReportCategory[]
  services        MunicipalService[]
  announcements   Announcement[]
  cityEvents      CityEvent[]
  serviceRequests ServiceRequest[]
}

model Address {
  id             Int      @id @default(autoincrement())
  userId         Int
  label          String?
  country        String
  city           String
  district       String?
  neighborhood   String?
  street         String?
  buildingNumber String?
  postalCode     String?
  latitude       Decimal? @db.Decimal(10, 7)
  longitude      Decimal? @db.Decimal(10, 7)
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isPrimary])
}

model SystemHealth {
  id        Int      @id @default(autoincrement())
  name      String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReportCategory {
  id           Int         @id @default(autoincrement())
  name         String      @unique
  description  String?
  icon         String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  reports      Report[]

  @@index([departmentId])
}

model Report {
  id                 Int                   @id @default(autoincrement())
  title              String
  description        String                @db.Text
  status             ReportStatus          @default(SUBMITTED)
  priority           ReportPriority        @default(MEDIUM)
  addressText        String?
  latitude           Decimal?              @db.Decimal(10, 7)
  longitude          Decimal?              @db.Decimal(10, 7)
  citizenId          Int
  categoryId         Int
  departmentId       Int?
  assignedEmployeeId Int?
  resolvedAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  citizen            User                  @relation("CitizenReports", fields: [citizenId], references: [id], onDelete: Restrict)
  category           ReportCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  department         Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignedEmployee   User?                 @relation("AssignedEmployeeReports", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  images             ReportImage[]
  statusHistory      ReportStatusHistory[]
  comments           ReportComment[]
  upvotes            ReportUpvote[]
  feedback           ReportFeedback?
  notifications      Notification[]

  @@index([citizenId, createdAt])
  @@index([categoryId])
  @@index([departmentId])
  @@index([assignedEmployeeId])
  @@index([status, createdAt])
  @@index([priority])
}

model ReportImage {
  id        Int      @id @default(autoincrement())
  reportId  Int
  imageUrl  String
  createdAt DateTime @default(now())
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model ReportStatusHistory {
  id          Int           @id @default(autoincrement())
  reportId    Int
  oldStatus   ReportStatus?
  newStatus   ReportStatus
  changedById Int
  note        String?
  createdAt   DateTime      @default(now())
  report      Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  changedBy   User          @relation("ReportStatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
  @@index([changedById])
}

model ReportComment {
  id              Int             @id @default(autoincrement())
  reportId        Int
  userId          Int
  parentCommentId Int?
  content         String          @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  report          Report          @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  parentComment   ReportComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies         ReportComment[] @relation("CommentReplies")

  @@index([reportId, createdAt])
  @@index([userId])
  @@index([parentCommentId])
  @@index([createdAt])
}

model ReportUpvote {
  id        Int      @id @default(autoincrement())
  reportId  Int
  userId    Int
  createdAt DateTime @default(now())
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([reportId, userId])
  @@index([userId])
  @@index([createdAt])
}

model ReportFeedback {
  id        Int      @id @default(autoincrement())
  reportId  Int      @unique
  citizenId Int
  rating    Int
  comment   String?  @db.Text
  confirmed Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  citizen   User     @relation("CitizenReportFeedback", fields: [citizenId], references: [id], onDelete: Restrict)

  @@index([citizenId])
}

model Notification {
  id               Int              @id @default(autoincrement())
  userId           Int
  type             NotificationType
  title            String
  message          String
  reportId         Int?
  serviceRequestId Int?
  actorId          Int?
  isRead           Boolean          @default(false)
  readAt           DateTime?
  createdAt        DateTime         @default(now())
  user             User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Restrict)
  report           Report?          @relation(fields: [reportId], references: [id], onDelete: SetNull)
  serviceRequest   ServiceRequest?  @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  actor            User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@index([reportId])
  @@index([serviceRequestId])
}

model MunicipalService {
  id              Int              @id @default(autoincrement())
  departmentId    Int
  title           String
  description     String           @db.Text
  instructions    String?          @db.Text
  requirements    String?          @db.Text
  contactPhone    String?
  contactEmail    String?
  externalUrl     String?
  address         String?
  imageUrl        String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  department      Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  serviceRequests ServiceRequest[]

  @@index([departmentId])
  @@index([isActive])
  @@index([title])
}

model ServiceRequest {
  id                   Int                           @id @default(autoincrement())
  serviceId            Int
  citizenId            Int
  departmentId         Int
  assignedEmployeeId   Int?
  status               ServiceRequestStatus          @default(SUBMITTED)
  description          String                        @db.Text
  address              String?
  latitude             Decimal?                      @db.Decimal(10, 7)
  longitude            Decimal?                      @db.Decimal(10, 7)
  preferredDate        DateTime?
  contactPhone         String?
  municipalityResponse String?                       @db.Text
  submittedAt          DateTime                      @default(now())
  completedAt          DateTime?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  service              MunicipalService              @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  citizen              User                          @relation("CitizenServiceRequests", fields: [citizenId], references: [id], onDelete: Restrict)
  department           Department                    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  assignedEmployee     User?                         @relation("AssignedServiceRequests", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  history              ServiceRequestStatusHistory[]
  notifications        Notification[]

  @@index([citizenId, createdAt])
  @@index([departmentId, status])
  @@index([assignedEmployeeId, status])
  @@index([serviceId])
}

model ServiceRequestStatusHistory {
  id               Int                   @id @default(autoincrement())
  serviceRequestId Int
  oldStatus        ServiceRequestStatus?
  newStatus        ServiceRequestStatus
  changedById      Int
  note             String?               @db.Text
  createdAt        DateTime              @default(now())
  serviceRequest   ServiceRequest        @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  changedBy        User                  @relation("ServiceRequestChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([serviceRequestId, createdAt])
  @@index([changedById])
}

model Announcement {
  id           Int         @id @default(autoincrement())
  departmentId Int?
  title        String
  content      String      @db.Text
  isPublished  Boolean     @default(false)
  publishedAt  DateTime?
  expiresAt    DateTime?
  imageUrl     String?
  createdById  Int
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdBy    User        @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([departmentId])
  @@index([isPublished, publishedAt])
  @@index([expiresAt])
}

model CityEvent {
  id           Int         @id @default(autoincrement())
  departmentId Int?
  title        String
  description  String      @db.Text
  locationName String?
  address      String?
  latitude     Decimal?    @db.Decimal(10, 7)
  longitude    Decimal?    @db.Decimal(10, 7)
  startsAt     DateTime
  endsAt       DateTime?
  externalUrl  String?
  imageUrl     String?
  isPublished  Boolean     @default(false)
  publishedAt  DateTime?
  createdById  Int
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdBy    User        @relation("CityEventCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([departmentId])
  @@index([isPublished, startsAt])
  @@index([startsAt])
}
